{
  "name": "@design-system-rte/core",
  "version": "1.22.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./design-tokens/*": "./dist/design-tokens/*",
    "./assets/*": "./dist/assets/*",
    "./css/*": "./dist/css/*",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "build": "npm run build:css-themes && npm run build:css-fonts && npm run bundle:core",
    "build:css-themes": "ts-node css-theme-generator.ts",
    "build:css-fonts": "ts-node css-font-generator.ts",
    "bundle:core": "ts-node scripts/bundle-core.ts",
    "generate:tokens": "ts-node ./scripts/design-tokens/generator.ts",
    "prepublishOnly": "npm run build"
  },
  "description": "Design tokens, shared interfaces, and utilities for Luciole (RTE Design System)",
  "keywords": [
    "design-system",
    "design-tokens",
    "sass",
    "ui",
    "rte",
    "accessibility"
  ],
  "author": "RTE",
  "license": "Apache-2.0",
  "homepage": "https://zeroheight.com/687a5ae28",
  "repository": {
    "type": "git",
    "url": "https://github.com/rte-france/design-system-rte.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://zeroheight.com/687a5ae28/p/5173b5-contribuer/b/65c380"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "sass": "^1.85.1"
  },
  "devDependencies": {
    "sass": "^1.89.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
